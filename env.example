# =============================================================================
# .env.example — File cấu hình mẫu cho Trợ lý Smart Meeting & Document OCR
# =============================================================================
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép file này và đổi tên thành '.env' tại cùng thư mục:
#      copy .env.example .env     (trên Windows)
#      cp .env.example .env       (trên Linux/macOS)
# 2. Điền các giá trị cấu hình thực tế bên dưới (đặc biệt là HF_TOKEN và FFMPEG_PATH).
# 3. Không commit file '.env' thật lên GitHub để bảo vệ token và thông tin cá nhân.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. Hugging Face Access Token (Bắt buộc cho phân hệ Smart Meeting)
# ─────────────────────────────────────────────────────────────────────────────
# Diart và Pyannote cần token Hugging Face để tải mô hình phân tách người nói.
# Các bước chuẩn bị:
#   Bước a. Đăng ký/Đăng nhập tại: https://huggingface.co
#   Bước b. Tạo token tại: https://huggingface.co/settings/tokens (chọn quyền 'Read')
#   Bước c. Bắt buộc bấm 'Agree / Acknowledge' chấp nhận điều khoản tại 2 trang model:
#           - https://huggingface.co/pyannote/segmentation-3.0
#           - https://huggingface.co/pyannote/embedding
HF_TOKEN=hf_your_huggingface_access_token_here

# (Tuỳ chọn) Pyannote Cloud API Key (để trống nếu chỉ dùng model local)
PYANNOTE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2. Cấu hình FFmpeg (Bắt buộc để chuẩn hoá âm thanh 16kHz)
# ─────────────────────────────────────────────────────────────────────────────
# Nếu ffmpeg đã được thêm vào System PATH thì chỉ cần để: ffmpeg
# Nếu chưa thêm vào PATH, hãy điền đường dẫn tuyệt đối tới file ffmpeg.exe:
# Ví dụ Windows: C:\ffmpeg\bin\ffmpeg.exe
# Ví dụ Linux:   /usr/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# ─────────────────────────────────────────────────────────────────────────────
# 3. Cấu hình Diart — Phân tách người nói trực tiếp (Online Diarization)
# ─────────────────────────────────────────────────────────────────────────────
# Preset tham số tối ưu (theo nghiên cứu của Diart):
#   - voxconverse : Khuyên dùng cho hội thoại, phỏng vấn, nhiều người nói
#   - ami         : Phù hợp cuộc họp nhỏ từ 2-4 người ngồi gần micro
#   - dihard      : Phù hợp môi trường nhiều tiếng ồn phức tạp
DIART_PRESET=voxconverse

# Mô hình Embedding trích xuất đặc trưng phân biệt giọng:
#   - pyannote/embedding                : Nhẹ, chạy nhanh (mặc định)
#   - speechbrain/spkrec-ecapa-voxceleb : Độ chính xác cao hơn, cần tải ~80MB
DIART_EMBEDDING=pyannote/embedding

# Mô hình Segmentation:
#   - Khanh17/toadam-segmentation-model : Model tinh chỉnh tối ưu cho tiếng Việt
#   - pyannote/segmentation-3.0         : Model gốc của Pyannote
DIART_SEGMENTATION=Khanh17/toadam-segmentation-model

# Thiết bị tính toán: 'cpu' hoặc 'cuda' (nếu có card đồ họa NVIDIA)
DIART_DEVICE=cpu

# Giới hạn số người nói tối đa trong phiên (Để trống = Tự động nhận diện)
DIART_MAX_SPEAKERS=

# Bước nhảy sliding window (giây, khuyến nghị 0.5s)
DIART_STEP=0.5

# Độ trễ đầu ra phân đoạn (giây, 0.5 = trễ thấp nhất, 3.5-5.0 = chính xác nhất)
DIART_LATENCY=3.5

# ─────────────────────────────────────────────────────────────────────────────
# 4. Cấu hình Zipformer STT — Nhận dạng tiếng Việt Streaming (sherpa-onnx)
# ─────────────────────────────────────────────────────────────────────────────
# Đường dẫn các file checkpoint mô hình Zipformer cục bộ
LIVE_MODEL_DIR=models/zipformer
LIVE_TOKENS=models/zipformer/config.json
LIVE_ENCODER=models/zipformer/encoder-epoch-31-avg-11-chunk-32-left-128.fp16.onnx
LIVE_DECODER=models/zipformer/decoder-epoch-31-avg-11-chunk-32-left-128.fp16.onnx
LIVE_JOINER=models/zipformer/joiner-epoch-31-avg-11-chunk-32-left-128.fp16.onnx

# Thông số luồng âm thanh đầu vào
LIVE_SAMPLE_RATE=16000
LIVE_CHUNK_FRAMES=3200

# ─────────────────────────────────────────────────────────────────────────────
# 5. Cấu hình Cam++ VoiceID (Định danh giọng nói 192 chiều)
# ─────────────────────────────────────────────────────────────────────────────
VOICEID_MODEL=models/speech_campplus_sv_zh-cn_16k-common

# ─────────────────────────────────────────────────────────────────────────────
# 6. Cấu hình Kết nối 3 Môi trường Conda song song
# ─────────────────────────────────────────────────────────────────────────────
# Hệ thống chạy trên môi trường chính 'smart_meeting_diart' và kết nối 2 môi
# trường phụ để tránh xung đột thư viện:
#
# Đường dẫn python.exe tới env 'uc3_ocr' (Xử lý tài liệu, layout, bảng biểu):
# Ví dụ: C:\Users\Username\anaconda3\envs\uc3_ocr\python.exe
UC3_OCR_PYTHON=

# Đường dẫn python.exe tới env 'deepseek_ocr' (Worker nhận dạng DeepSeek):
# Ví dụ: C:\Users\Username\anaconda3\envs\deepseek_ocr\python.exe
DEEPSEEK_OCR_PYTHON=

# ─────────────────────────────────────────────────────────────────────────────
# 7. Tuỳ chọn Hệ thống & Debug
# ─────────────────────────────────────────────────────────────────────────────
# Bật in log chi tiết của luồng Live Streaming ra terminal (1 = Bật, 0 = Tắt)
LIVE_DEBUG=0
